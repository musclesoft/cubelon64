; Morph kite vertices for 50 Hz states 1-20 (state 0 is the marching square), 4 bytes per state
; Kite: A=(a,a) B=(p,q) C=(c,c) D=(q,p), mirrored into all four tile corners
; Bytes: outer tip a, then c-a, p-a, q-a (inner tip c, side vertices p and q relative to a)
; Decode to the rasterizer's 8.8 words (48x48 supersample frame, +4 pixel shift included):
;   a word = byte0 * 16 + MORPH_OUTER_BASE
;   c word = a word + byte1 * 8 + MORPH_INNER_BASE, p word with byte2 and MORPH_NEAR_BASE, q word with byte3 and MORPH_FAR_BASE
; Use a word as is for X; subtract $0080 from it for Y (the rasterizer samples scanlines at their top edge)

MORPH_OUTER_BASE = 1392
MORPH_INNER_BASE = 3856
MORPH_NEAR_BASE = 3680
MORPH_FAR_BASE = 0

