; Generated by proto (go run . morph), do not edit
; Morph kite vertices for 50 Hz states 1-20 (state 0 is the marching square), four 20-byte arrays
; Index every array with X = state - 1, so stepping through the states is INX or DEX
; Kite: A=(a,a) B=(p,q) C=(c,c) D=(q,p), mirrored into all four tile corners
; Line comments show the decoded coordinate in pixels: a, c, p or q
; Decode to the rasterizer's 8.8 words (48x48 supersample frame, +4 pixel shift included):
;   a word = morph_outer_table,X * 16 + MORPH_OUTER_BASE
;   c word = a word + morph_inner_table,X * 8 + MORPH_INNER_BASE
;   p word = a word + morph_near_table,X * 8 + MORPH_NEAR_BASE
;   q word = a word + morph_far_table,X * 8 + MORPH_FAR_BASE
; Use a word as is for X; subtract $0080 from it for Y (the rasterizer samples scanlines at their top edge)

MORPH_OUTER_BASE = 1392
MORPH_INNER_BASE = 3856
MORPH_NEAR_BASE = 3680
MORPH_FAR_BASE = 0

