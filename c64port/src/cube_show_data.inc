; Generated by proto (go run -C proto . cube), do not edit
; The unrolled and tabled parts of cube_show.s: the screen's codes, the sprite pointers of each ring,
; the chars' copy into each ring and the ring buffer's slot addresses

; Write the codes of the next 4 tile rows of the grid into screen A, a table row for the 3 lines of a
; tile row with the line added: the two steps of the switch take a frame each
.proc cube_write_screen
    ldx CUBE_SCREEN_STEP
    lda screen_start_low,x
    sta CUBE_SHOW_DST
    lda screen_start_high,x
    sta CUBE_SHOW_DST + 1
    lda screen_first_code,x
    tax
    clc
    adc #96
    sta CUBE_SCREEN_END
@tile_row:
    lda #0
    sta CUBE_LINE
@line:
    stx CUBE_ROW_START
    lda CUBE_SHOW_DST
    sta @store + 1
    lda CUBE_SHOW_DST + 1
    sta @store + 2
    ldy #0
@code:
    lda cube_screen_codes,x
    clc
    adc CUBE_LINE
@store:
    sta $FFFF,y
    inx
    iny
    cpy #24
    bne @code
    ldx CUBE_ROW_START
    lda CUBE_SHOW_DST
    clc
    adc #40
    sta CUBE_SHOW_DST
    bcc @same_page
    inc CUBE_SHOW_DST + 1
@same_page:
    inc CUBE_LINE
    lda CUBE_LINE
    cmp #3
    bne @line
    txa
    clc
    adc #24
    tax
    cpx CUBE_SCREEN_END
    bne @tile_row
    inc CUBE_SCREEN_STEP
    rts
.endproc

screen_start_low:
    .byte <GRID_ORIGIN, <CUBE_SCREEN_SECOND
screen_start_high:
    .byte >GRID_ORIGIN, >CUBE_SCREEN_SECOND
screen_first_code:
    .byte 0, 96

